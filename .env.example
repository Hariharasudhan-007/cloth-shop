# Thread & Loom Production Environment Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_secure_random_string_in_production
DATABASE_PATH=./data/store.db
UPLOAD_DIR=./uploads
STORE_NAME="Thread & Loom"
CURRENCY_SYMBOL="$"
CURRENCY_CODE="USD"
ADMIN_EMAIL=admin@threadandloom.com
ADMIN_DEFAULT_PASSWORD=AdminPass123!

# Webhook Secrets (for production payment gateways)
PAYMENT_GATEWAY_WEBHOOK_SECRET=replace_with_gateway_webhook_signing_secret

# Indian Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
PAYMENT_MODE=live
